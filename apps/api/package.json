{
  "name": "@cost-watchdog/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:workers": "tsx watch src/workers/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:workers": "node dist/workers/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed:demo": "tsx prisma/seed-enterprise.ts",
    "seed:minimal": "tsx prisma/seed.ts",
    "seed:e2e": "tsx scripts/seed-e2e.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/s3-request-presigner": "^3.500.0",
    "@cost-watchdog/connectors": "workspace:*",
    "@cost-watchdog/core": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@node-rs/argon2": "^1.7.0",
    "@prisma/client": "^5.10.0",
    "bullmq": "^5.1.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "fastify": "^5.7.4",
    "fastify-plugin": "^5.1.0",
    "file-type": "^21.1.1",
    "ioredis": "^5.3.0",
    "jose": "^5.2.0",
    "otplib": "^12.0.1",
    "prom-client": "^15.1.0",
    "resend": "^6.5.2",
    "ua-parser-js": "^1.0.37",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/ua-parser-js": "^0.7.39",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^8.56.0",
    "prisma": "^5.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.1"
  }
}
